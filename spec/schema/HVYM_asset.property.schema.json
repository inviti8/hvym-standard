{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "HVYM_asset.property.schema.json",
    "title": "HVYM_asset Property",
    "type": "object",
    "description": "A named, typed value with a rule for who may change it and how.",
    "properties": {
        "name": {
            "type": "string",
            "description": "An identifier, unique in the asset.",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": [ "bool", "int", "float", "color", "choice", "string" ] },
        "default": { "description": "The value in the template. Its JSON type follows `type`." },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "options": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 256, "default": 64 },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 9, "default": 3 },
        "lifetime": { "type": "string", "enum": [ "view", "constant", "mint", "live" ] },
        "change": { "type": "string", "enum": [ "set", "increase", "decrease", "step" ] },
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "by": {
            "type": "array",
            "items": { "type": "string", "enum": [ "owner", "creator", "delegate" ] },
            "minItems": 1,
            "uniqueItems": true
        },
        "extensions": { },
        "extras": { }
    },
    "required": [ "name", "type", "default", "lifetime" ],
    "allOf": [
        { "$ref": "glTFProperty.schema.json" },
        {
            "if": { "properties": { "type": { "const": "bool" } } },
            "then": { "properties": { "default": { "type": "boolean" } } }
        },
        {
            "if": { "properties": { "type": { "const": "int" } } },
            "then": {
                "properties": {
                    "default": { "type": "integer" },
                    "min": { "type": "integer" },
                    "max": { "type": "integer" },
                    "amount": { "type": "integer" }
                },
                "required": [ "min", "max" ]
            }
        },
        {
            "if": { "properties": { "type": { "const": "float" } } },
            "then": { "properties": { "default": { "type": "number" } }, "required": [ "min", "max" ] }
        },
        {
            "if": { "properties": { "type": { "const": "color" } } },
            "then": {
                "properties": {
                    "default": {
                        "type": "array",
                        "items": { "type": "number", "minimum": 0, "maximum": 1 },
                        "minItems": 4,
                        "maxItems": 4
                    }
                }
            }
        },
        {
            "if": { "properties": { "type": { "const": "choice" } } },
            "then": { "properties": { "default": { "type": "integer", "minimum": 0 } }, "required": [ "options" ] }
        },
        {
            "if": { "properties": { "type": { "const": "string" } } },
            "then": { "properties": { "default": { "type": "string" } } }
        },
        {
            "if": { "properties": { "lifetime": { "const": "live" } } },
            "then": { "required": [ "change", "by" ] },
            "else": {
                "not": { "anyOf": [ { "required": [ "change" ] }, { "required": [ "by" ] }, { "required": [ "amount" ] } ] }
            }
        }
    ]
}
