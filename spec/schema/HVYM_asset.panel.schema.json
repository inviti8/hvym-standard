{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "HVYM_asset.panel.schema.json",
    "title": "HVYM_asset Panel",
    "type": "object",
    "description": "A group of properties shown together, optionally anchored to a node.",
    "$defs": {
        "color": {
            "type": "array",
            "items": { "type": "number", "minimum": 0, "maximum": 1 },
            "minItems": 4,
            "maxItems": 4
        }
    },
    "properties": {
        "name": { "type": "string" },
        "anchor": { "type": "integer", "minimum": 0, "description": "The node the panel sits at." },
        "align": { "type": "string", "enum": [ "center", "left", "right" ], "default": "center" },
        "colors": {
            "type": "object",
            "properties": {
                "primary": { "$ref": "#/$defs/color" },
                "secondary": { "$ref": "#/$defs/color" },
                "text": { "$ref": "#/$defs/color" }
            },
            "additionalProperties": false
        },
        "groups": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "label": { "type": "string" },
                    "properties": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
                },
                "required": [ "properties" ],
                "additionalProperties": false
            },
            "minItems": 1
        },
        "extensions": { },
        "extras": { }
    },
    "required": [ "groups" ],
    "allOf": [ { "$ref": "glTFProperty.schema.json" } ]
}
